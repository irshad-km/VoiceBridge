<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Translation Result | VoiceBridge</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #080d1d;
    --panel: #0d1427;
    --panel2: #111a30;
    --border: #202b43;
    --text: #f4f7ff;
    --muted: #7f8aa5;
    --blue: #4c9cff;
    --cyan: #52d9ff;
    --green: #35d39a;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* ================= NAVBAR ================= */

.navbar {
    height: 64px;
    padding: 0 5%;
    border-bottom: 1px solid var(--border);
    background: #080d1d;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.logo {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
}

.logo span {
    color: var(--blue);
}

.nav-center {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.nav-link {
    color: #8792ad;
    text-decoration: none;
    font-size: 12px;
    padding: 9px 14px;
    border-radius: 8px;
    transition: 0.2s ease;
}

.nav-link:hover {
    color: white;
    background: #111a30;
}

.nav-link.active {
    background: #182541;
    color: #62b4ff;
}

.profile {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #202b43;
    border: 1px solid #34415e;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: #aab5cb;
}

/* ================= MAIN ================= */

.container {
    width: min(1080px, 90%);
    margin: 34px auto 70px;
    flex: 1;
}

.header {
    text-align: center;
    margin-bottom: 24px;
}

.complete-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 11px;
    border-radius: 20px;
    border: 1px solid #24527c;
    background: #0c2035;
    color: #5ec4ff;
    font-size: 10px;
    font-weight: 700;
    margin-bottom: 12px;
}

.complete-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px rgba(53, 211, 154, .7);
}

.header h1 {
    font-size: 30px;
    line-height: 1.2;
    margin-bottom: 7px;
    letter-spacing: -1px;
}

.header h1 span {
    color: #54aaff;
}

.header p {
    color: var(--muted);
    font-size: 12px;
}

/* ================= LANGUAGE ================= */

.language-bar {
    width: fit-content;
    margin: 0 auto 22px;
    padding: 8px 14px;
    border-radius: 9px;
    background: #10192d;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
}

.language {
    color: #e5ebf8;
    font-weight: 700;
}

.arrow {
    color: #65718c;
}

.change {
    color: var(--blue);
    cursor: pointer;
    font-size: 10px;
    text-decoration: none;
}

.change:hover {
    color: #78bbff;
}

/* ================= RESULT GRID ================= */

.result-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    gap: 18px;
    align-items: stretch;
}

.card {
    background: linear-gradient(
        145deg,
        #10182c,
        #0c1325
    );
    border: 1px solid var(--border);
    border-radius: 13px;
    overflow: hidden;
    min-width: 0;
    height: 100%;
}

.card-header {
    min-height: 54px;
    padding: 14px 17px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.card-title {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
}

.card-title h2 {
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.small-label {
    color: #67738d;
    font-size: 9px;
    white-space: nowrap;
}

.card-body {
    padding: 17px;
}

/* ================= ORIGINAL AUDIO / TEXT ================= */

.audio-box {
    background: #080f20;
    border: 1px solid #1c2740;
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 15px;
}

.audio-top {
    display: flex;
    align-items: center;
    gap: 10px;
}

.play-btn {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border: none;
    border-radius: 50%;
    background: #50b9ff;
    color: #06101e;
    cursor: pointer;
    font-size: 12px;
    font-weight: bold;
    transition: 0.2s ease;
}

.play-btn:hover {
    opacity: 0.9;
    transform: scale(1.03);
}

.audio-info {
    flex: 1;
    min-width: 0;
}

.audio-name {
    font-size: 10px;
    color: #dce5f5;
    margin-bottom: 4px;
}

.audio-time {
    color: #68748e;
    font-size: 8px;
}

.waveform {
    height: 38px;
    margin-top: 9px;
    display: flex;
    align-items: center;
    gap: 3px;
    overflow: hidden;
}

.waveform span {
    width: 3px;
    min-width: 3px;
    border-radius: 3px;
    background: #3e78b1;
}

.waveform span:nth-child(1) { height: 10px; }
.waveform span:nth-child(2) { height: 20px; }
.waveform span:nth-child(3) { height: 14px; }
.waveform span:nth-child(4) { height: 28px; }
.waveform span:nth-child(5) { height: 19px; }
.waveform span:nth-child(6) { height: 34px; }
.waveform span:nth-child(7) { height: 22px; }
.waveform span:nth-child(8) { height: 14px; }
.waveform span:nth-child(9) { height: 27px; }
.waveform span:nth-child(10) { height: 17px; }
.waveform span:nth-child(11) { height: 31px; }
.waveform span:nth-child(12) { height: 21px; }
.waveform span:nth-child(13) { height: 12px; }
.waveform span:nth-child(14) { height: 25px; }
.waveform span:nth-child(15) { height: 16px; }
.waveform span:nth-child(16) { height: 29px; }
.waveform span:nth-child(17) { height: 19px; }
.waveform span:nth-child(18) { height: 11px; }

/* ================= TEXT ================= */

.section-label {
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #66728b;
    margin-bottom: 8px;
}

.original-text {
    color: #e5eaf4;
    font-size: 16px;
    line-height: 1.6;
    padding: 14px;
    background: #0a1121;
    border: 1px solid #1b263d;
    border-radius: 9px;
    word-break: break-word;
    overflow-wrap: anywhere;
}

/* ================= TRANSLATION ================= */

.translation-card {
    position: relative;
}

.translation-card .card-header {
    border-bottom-color: #214365;
}

.translation-badge {
    font-size: 8px;
    padding: 4px 7px;
    border-radius: 5px;
    background: #102d42;
    border: 1px solid #245a82;
    color: #58c9ff;
    white-space: nowrap;
}

.translated-text {
    min-height: 125px;
    padding: 16px;
    border-radius: 9px;
    background: #0b1a2d;
    border: 1px solid #1b4265;
    color: #f0f6ff;
    font-size: 17px;
    line-height: 1.6;
    word-break: break-word;
    overflow-wrap: anywhere;
}

.translated-text strong {
    color: #ffffff;
}

/* ================= TRANSLATED AUDIO ================= */

.translated-audio {
    margin-bottom: 16px;
    padding: 11px;
    border-radius: 9px;
    background: #091426;
    border: 1px solid #1c3553;
}

.translated-audio .waveform {
    margin-top: 9px;
}

.translated-audio .waveform span {
    background: #319dd1;
}

/* ================= BUTTONS ================= */

.actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 9px;
    margin-top: 20px;
    flex-wrap: wrap;
}

.action-btn {
    text-decoration: none;
    border-radius: 8px;
    padding: 9px 14px;
    font-size: 10px;
    font-weight: 700;
    cursor: pointer;
    border: 1px solid var(--border);
    transition: 0.2s ease;
}

.primary {
    background: #52a9ff;
    color: #07101f;
    border-color: #52a9ff;
}

.secondary {
    background: #10192d;
    color: #aeb9ce;
}

.action-btn:hover {
    transform: translateY(-1px);
}

.primary:hover {
    background: #63b2ff;
}

.secondary:hover {
    color: #e8efff;
    border-color: #30415f;
}

/* ================= WHATSAPP ================= */

.whatsapp-btn {
    background: #123b2d;
    color: #52e6a8;
    border-color: #23694e;
}

.whatsapp-btn:hover {
    background: #174b39;
    color: #72f2ba;
    border-color: #2b8b66;
}

/* ================= RELATED ================= */

.related {
    margin-top: 30px;
}

.related-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    gap: 10px;
}

.related-title h3 {
    font-size: 11px;
}

.related-title span {
    color: #66738e;
    font-size: 8px;
}

.related-box {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #0d1426;
    padding: 6px 14px;
}

.related-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    padding: 11px 0;
    border-bottom: 1px solid #19233a;
}

.related-item:last-child {
    border-bottom: none;
}

.related-left {
    display: flex;
    gap: 9px;
    align-items: center;
    min-width: 0;
    flex: 1;
}

.mini-play {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid #293751;
    background: #121d33;
    color: #69baff;
    cursor: pointer;
    font-size: 8px;
    transition: 0.2s ease;
}

.mini-play:hover {
    background: #182641;
    border-color: #3b5278;
}

.related-text {
    font-size: 9px;
    color: #b5bfd1;
    word-break: break-word;
    overflow-wrap: anywhere;
}

.related-date {
    font-size: 8px;
    color: #5e6a82;
    white-space: nowrap;
}

/* ================= FOOTER ================= */

footer {
    margin-top: auto;
    padding: 18px 5%;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    color: #56627a;
    font-size: 8px;
}

footer a {
    color: #65718b;
    text-decoration: none;
    margin-left: 14px;
    transition: 0.2s ease;
}

footer a:hover {
    color: #9ba9c4;
}

/* ================= RESPONSIVE ================= */

@media (max-width: 850px) {

    .result-grid {
        grid-template-columns: 1fr;
    }

}

@media (max-width: 750px) {

    .navbar {
        padding: 0 20px;
    }

    .nav-center {
        display: none;
    }

    .container {
        width: 92%;
        margin-top: 25px;
    }

    .header h1 {
        font-size: 25px;
    }

    .result-grid {
        grid-template-columns: 1fr;
    }

    .actions {
        flex-direction: column;
        align-items: stretch;
    }

    .action-btn {
        width: 100%;
        text-align: center;
    }

    footer {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    footer a {
        margin-left: 0;
        margin-right: 12px;
    }

}

@media (max-width: 480px) {

    .container {
        width: 94%;
    }

    .header h1 {
        font-size: 23px;
    }

    .language-bar {
        max-width: 100%;
        gap: 8px;
        padding: 8px 10px;
    }

    .card-header {
        padding: 13px;
    }

    .card-body {
        padding: 13px;
    }

    .card-title h2 {
        font-size: 11px;
    }

    .translation-badge {
        font-size: 7px;
    }

    .original-text {
        font-size: 15px;
    }

    .translated-text {
        font-size: 16px;
    }

    .related-item {
        align-items: flex-start;
    }

}

</style>

</head>

<body>

        <%- include("partials/navbar", { currentPage: "home" }) %>



<!-- ================= MAIN ================= -->

<main class="container">

    <section class="header">

        <div class="complete-badge">

            <span class="complete-dot"></span>

            Translation Complete

        </div>

        <h1>
            Your Translation Is <span>Ready</span>
        </h1>

        <p>
            Listen, review and copy your translated speech.
        </p>

    </section>


    <!-- LANGUAGE -->

    <div class="language-bar">

        <span class="language">

            <%= translation.sourceLanguage === "ML"
                ? "Malayalam"
                : translation.sourceLanguage %>

        </span>

        <span class="arrow">
            →
        </span>

        <span class="language">

            <%= translation.targetLanguage === "EN"
                ? "English"
                : translation.targetLanguage %>

        </span>

        <a
            href="/translate"
            class="change"
        >
            Change
        </a>

    </div>


    <!-- RESULT -->

    <section class="result-grid">


        <!-- ================= ORIGINAL ================= -->

        <div class="card">

            <div class="card-header">

                <div class="card-title">

                    <h2>
                        Original Audio
                    </h2>

                    <span class="small-label">

                        <%= translation.sourceLanguage === "ML"
                            ? "Malayalam"
                            : translation.sourceLanguage %>

                    </span>

                </div>

                <span class="small-label">
                    Audio
                </span>

            </div>


            <div class="card-body">

                <div class="section-label">
                    Detected Speech
                </div>

                <div
                    class="original-text"
                    id="originalText"
                >

                    <%= translation.originalText %>

                </div>

            </div>

        </div>


        <!-- ================= TRANSLATION ================= -->

        <div class="card translation-card">

            <div class="card-header">

                <div class="card-title">

                    <h2>

                        <%= translation.targetLanguage === "EN"
                            ? "English"
                            : translation.targetLanguage %>

                        Speech Output

                    </h2>

                    <span class="translation-badge">
                        AI Translated
                    </span>

                </div>

                <span class="small-label">
                    Translation
                </span>

            </div>


            <div class="card-body">


                <!-- TRANSLATED AUDIO -->

                <div class="translated-audio">

                    <div class="audio-top">

                        <button
                            id="translatedPlayBtn"
                            class="play-btn"
                            onclick="toggleTranslatedAudio(this)"
                        >
                            ▶
                        </button>

                        <div class="audio-info">

                            <div class="audio-name">
                                Translated Speech
                            </div>

                            <div
                                class="audio-time"
                                id="translatedAudioStatus"
                            >
                                Translated audio
                            </div>

                        </div>

                    </div>


                    <div class="waveform">

                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>

                    </div>

                </div>


                <!-- HIDDEN AUDIO ELEMENT -->

                <% if (translation.translatedAudioUrl) { %>

                    <audio
                        id="translatedAudio"
                        preload="metadata"
                        src="<%= translation.translatedAudioUrl %>"
                    ></audio>

                <% } %>


                <div
                    class="section-label"
                    style="margin-top:16px;"
                >
                    Translated Text
                </div>


                <div
                    class="translated-text"
                    id="translatedText"
                >

                    <%= translation.translatedText %>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= ACTIONS ================= -->

    <div class="actions">

        <a
            href="/translate"
            class="action-btn primary"
        >
            🔄 Translate Again
        </a>


        <button
            class="action-btn secondary"
            onclick="copyText('translatedText')"
        >
            Copy Text
        </button>


    <a
    href="<%= translation.translatedAudioUrl %>"
    download="voicebridge-translated-audio.mp3"
    class="action-btn secondary"
>
    ↓ Download Audio
</a>


        <!-- ================= WHATSAPP ================= -->

        <button
            class="action-btn whatsapp-btn"
            onclick="shareToWhatsApp()"
        >
            💬 Share to WhatsApp
        </button>


        <a
            href="/"
            class="action-btn secondary"
        >
            ← Home
        </a>

    </div>


    <!-- ================= RELATED ================= -->

    <section class="related">

        <div class="related-title">

            <h3>
                Recent Translations
            </h3>

            <span>
                Current translation
            </span>

        </div>


        <div class="related-box">


            <div class="related-item">

                <div class="related-left">

                    <button
                        class="mini-play"
                        onclick="toggleTranslatedAudio(document.getElementById('translatedPlayBtn'))"
                    >
                        ▶
                    </button>

                    <div>

                        <div class="related-text">

                            <%= translation.originalText %>

                        </div>

                        <div class="related-date">

                            <%= translation.sourceLanguage === "ML"
                                ? "Malayalam"
                                : translation.sourceLanguage %>

                            →

                            <%= translation.targetLanguage === "EN"
                                ? "English"
                                : translation.targetLanguage %>

                        </div>

                    </div>

                </div>

                <div class="related-date">
                    Current
                </div>

            </div>


            <div class="related-item">

                <div class="related-left">

                    <button
                        class="mini-play"
                        onclick="toggleTranslatedAudio(document.getElementById('translatedPlayBtn'))"
                    >
                        ▶
                    </button>

                    <div>

                        <div class="related-text">

                            <%= translation.translatedText %>

                        </div>

                        <div class="related-date">
                            Translated Text
                        </div>

                    </div>

                </div>

                <div class="related-date">

                    <%= new Date(
                        translation.createdAt
                    ).toLocaleTimeString([], {
                        hour: "2-digit",
                        minute: "2-digit"
                    }) %>

                </div>

            </div>


        </div>

    </section>

</main>


<!-- ================= FOOTER ================= -->

<footer>

    <div>
        © 2026 VoiceBridge. All rights reserved.
    </div>

    <div>

        <a href="#">
            Privacy
        </a>

        <a href="#">
            Terms
        </a>

        <a href="#">
            Help
        </a>

        <a href="#">
            Contact
        </a>

    </div>

</footer>


<script>

/* ================= COPY TEXT ================= */

function copyText(id) {

    const element =
        document.getElementById(id);

    if (!element) {
        return;
    }

    const text =
        element.innerText;

    navigator.clipboard.writeText(text)

        .then(() => {

            alert("Text copied!");

        })

        .catch(() => {

            alert("Could not copy text.");

        });

}


/* ================= DOWNLOAD ================= */




/* ================= WHATSAPP ================= */

async function shareToWhatsApp() {

    const audio =
        document.getElementById("translatedAudio");

    if (!audio || !audio.src) {
        alert("Translated audio is not available.");
        return;
    }

    try {

        const response = await fetch(audio.src);

        if (!response.ok) {
            throw new Error("Audio download failed");
        }

        const blob = await response.blob();

        const file = new File(
            [blob],
            "voicebridge-translated-audio.mp3",
            {
                type: "audio/mpeg"
            }
        );

        if (
            navigator.share &&
            navigator.canShare &&
            navigator.canShare({ files: [file] })
        ) {

            await navigator.share({
                files: [file],
                title: "VoiceBridge Translation",
                text: "Translated audio from VoiceBridge"
            });

        } else {

            alert(
                "Direct audio sharing is not supported on this browser. Please download the audio and share it on WhatsApp."
            );

        }

    } catch (error) {

        console.error(
            "WhatsApp audio share error:",
            error
        );

        if (error.name !== "AbortError") {
            alert("Could not share the translated audio.");
        }

    }
}


/* ================= TRANSLATED AUDIO ================= */

function toggleTranslatedAudio(button) {

    const audio =
        document.getElementById("translatedAudio");

    const status =
        document.getElementById("translatedAudioStatus");

    if (!audio) {

        alert(
            "Translated audio is not available."
        );

        return;
    }


    if (audio.paused) {

        audio.play()

            .then(() => {

                button.innerText = "Ⅱ";

                if (status) {

                    status.innerText =
                        "Playing translated audio";

                }

            })

            .catch((error) => {

                console.error(
                    "Audio playback error:",
                    error
                );

                alert(
                    "Could not play translated audio."
                );

            });

    } else {

        audio.pause();

        button.innerText = "▶";

        if (status) {

            status.innerText =
                "Translated audio";

        }

    }

}


/* ================= AUDIO ENDED ================= */

document.addEventListener(
    "DOMContentLoaded",
    () => {

        const audio =
            document.getElementById(
                "translatedAudio"
            );

        const button =
            document.getElementById(
                "translatedPlayBtn"
            );

        const status =
            document.getElementById(
                "translatedAudioStatus"
            );


        if (!audio) {
            return;
        }


        audio.addEventListener(
            "ended",
            () => {

                if (button) {

                    button.innerText = "▶";

                }

                if (status) {

                    status.innerText =
                        "Translated audio";

                }

            }
        );

    }
);


/* ================= ORIGINAL AUDIO ================= */

function toggleOriginalAudio(button) {

    /*
     * Original uploaded audio is currently deleted
     * after translation in the backend.
     *
     * So this button is kept visually,
     * but actual original-audio playback will be
     * added later when original audio is stored.
     */

    alert(
        "Original audio playback will be available after storing the recorded audio."
    );

}

</script>

