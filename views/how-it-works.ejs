<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description"
        content="Learn how VoiceBridge converts Malayalam speech into English translation and voice." />

    <title>How It Works | VoiceBridge</title>

    <script src="https://unpkg.com/lucide@latest"></script>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Inter, -apple-system, BlinkMacSystemFont,
                "Segoe UI", Roboto, Arial, sans-serif;

            background: #020817;
            color: #e5f0ff;
            min-height: 100vh;
            overflow-x: hidden;
        }


        /* =========================
           PREMIUM BACKGROUND
        ========================== */

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: -3;

            background:
                radial-gradient(
                    circle at 15% 15%,
                    rgba(37, 99, 235, 0.18),
                    transparent 32%
                ),
                radial-gradient(
                    circle at 85% 20%,
                    rgba(6, 182, 212, 0.12),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 50% 90%,
                    rgba(99, 102, 241, 0.10),
                    transparent 35%
                );

            animation: backgroundPulse 10s ease-in-out infinite alternate;
        }


        body::after {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: -2;

            background-image:
                linear-gradient(
                    rgba(59, 130, 246, 0.035) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(59, 130, 246, 0.035) 1px,
                    transparent 1px
                );

            background-size: 45px 45px;

            animation: gridMove 22s linear infinite;
        }


        @keyframes backgroundPulse {

            0% {
                transform: scale(1);
                opacity: 0.8;
            }

            50% {
                transform: scale(1.05);
                opacity: 1;
            }

            100% {
                transform: scale(1.02);
                opacity: 0.85;
            }
        }


        @keyframes gridMove {

            from {
                background-position: 0 0;
            }

            to {
                background-position: 45px 45px;
            }
        }



        /* =========================
           NAVBAR
        ========================== */

        .navbar {

            width: 100%;
            height: 78px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 7%;

            position: sticky;
            top: 0;
            z-index: 1000;

            background: rgba(2, 8, 23, 0.78);

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            border-bottom:
                1px solid rgba(96, 165, 250, 0.12);

            animation: navbarDrop 0.8s ease both;
        }


        @keyframes navbarDrop {

            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        .brand {

            display: flex;
            align-items: center;
            gap: 11px;

            color: #ffffff;
            text-decoration: none;

            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.4px;

            transition: transform 0.3s ease;
        }


        .brand:hover {
            transform: translateY(-2px);
        }


        .brand-icon {

            width: 38px;
            height: 38px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 11px;

            background:
                linear-gradient(
                    135deg,
                    rgba(37, 99, 235, 0.95),
                    rgba(6, 182, 212, 0.9)
                );

            box-shadow:
                0 0 25px rgba(37, 99, 235, 0.25);

            animation: brandGlow 3s ease-in-out infinite;
        }


        @keyframes brandGlow {

            0%,
            100% {
                box-shadow:
                    0 0 20px rgba(37, 99, 235, 0.20);
            }

            50% {
                box-shadow:
                    0 0 35px rgba(6, 182, 212, 0.45);
            }
        }


        .brand-icon i {

            width: 20px;
            height: 20px;
            color: white;
        }


        .nav-links {

            display: flex;
            align-items: center;
            gap: 28px;
        }


        .nav-links a {

            position: relative;

            color: #8fa4c2;
            text-decoration: none;

            font-size: 14px;
            font-weight: 500;

            padding: 28px 0;

            transition:
                color 0.3s ease,
                transform 0.3s ease;
        }


        .nav-links a:hover {

            color: #ffffff;
            transform: translateY(-2px);
        }


        .nav-links a.active {
            color: #ffffff;
        }


        .nav-links a.active::after {

            content: "";

            position: absolute;

            left: 50%;
            bottom: 17px;

            width: 26px;
            height: 2px;

            transform: translateX(-50%);

            background: #3d9cff;

            border-radius: 10px;

            box-shadow:
                0 0 10px rgba(61, 156, 255, 0.8);

            animation: activeLine 2s ease-in-out infinite;
        }


        @keyframes activeLine {

            0%,
            100% {
                opacity: 0.65;
                box-shadow:
                    0 0 7px rgba(61, 156, 255, 0.5);
            }

            50% {
                opacity: 1;
                box-shadow:
                    0 0 16px rgba(61, 156, 255, 0.95);
            }
        }


        .profile {

            width: 38px;
            height: 38px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background:
                rgba(59, 130, 246, 0.12);

            border:
                1px solid rgba(96, 165, 250, 0.22);

            color: #93c5fd;

            font-size: 12px;
            font-weight: 700;

            transition:
                transform 0.3s ease,
                box-shadow 0.3s ease;
        }


        .profile:hover {

            transform: scale(1.08);

            box-shadow:
                0 0 20px rgba(59, 130, 246, 0.25);
        }


        .menu-btn {

            display: none;

            border: none;
            background: transparent;

            color: white;

            cursor: pointer;
        }


        .menu-btn i {

            width: 24px;
            height: 24px;
        }



        /* =========================
           HERO
        ========================== */

        .hero {

            min-height: 70vh;

            display: flex;
            flex-direction: column;

            align-items: center;
            justify-content: center;

            text-align: center;

            padding: 100px 20px 80px;

            position: relative;

            overflow: hidden;
        }


        .hero::before {

            content: "";

            position: absolute;

            width: 500px;
            height: 500px;

            border-radius: 50%;

            background:
                rgba(37, 99, 235, 0.10);

            filter: blur(100px);

            top: 20px;
            left: 50%;

            transform: translateX(-50%);

            z-index: -1;

            animation:
                heroGlow 7s ease-in-out infinite;
        }


        @keyframes heroGlow {

            0%,
            100% {
                transform:
                    translateX(-50%)
                    scale(0.9);

                opacity: 0.6;
            }

            50% {
                transform:
                    translateX(-50%)
                    scale(1.15);

                opacity: 1;
            }
        }


        .hero::after {

            content: "";

            position: absolute;

            width: 160px;
            height: 160px;

            border-radius: 50%;

            background:
                rgba(34, 211, 238, 0.08);

            filter: blur(45px);

            right: 10%;
            top: 25%;

            z-index: -1;

            animation:
                floatingOrb 8s ease-in-out infinite;
        }


        @keyframes floatingOrb {

            0%,
            100% {
                transform:
                    translate(0, 0)
                    scale(1);
            }

            50% {
                transform:
                    translate(-40px, 35px)
                    scale(1.2);
            }
        }


        .hero-badge {

            display: inline-flex;

            align-items: center;
            gap: 8px;

            padding: 8px 15px;

            margin-bottom: 25px;

            border-radius: 30px;

            background:
                rgba(59, 130, 246, 0.08);

            border:
                1px solid rgba(96, 165, 250, 0.18);

            color: #7dd3fc;

            font-size: 12px;
            font-weight: 600;

            letter-spacing: 0.5px;

            animation:
                fadeUp 0.8s 0.15s ease both;
        }


        .hero-badge i {

            width: 14px;
            height: 14px;

            animation:
                badgeSpin 5s linear infinite;
        }


        @keyframes badgeSpin {

            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }


        .hero h1 {

            max-width: 900px;

            font-size:
                clamp(42px, 7vw, 76px);

            line-height: 1.02;

            letter-spacing: -3px;

            color: white;

            margin-bottom: 25px;

            animation:
                fadeUp 0.9s 0.3s ease both;
        }


        .hero h1 span {

            background:
                linear-gradient(
                    90deg,
                    #60a5fa,
                    #22d3ee,
                    #818cf8
                );

            -webkit-background-clip: text;
            background-clip: text;

            color: transparent;

            background-size: 200% auto;

            animation:
                gradientFlow 5s linear infinite;
        }


        @keyframes gradientFlow {

            0% {
                background-position: 0% center;
            }

            100% {
                background-position: 200% center;
            }
        }


        .hero p {

            max-width: 690px;

            color: #8fa4c2;

            font-size: 17px;
            line-height: 1.8;

            animation:
                fadeUp 0.9s 0.45s ease both;
        }


        @keyframes fadeUp {

            from {
                opacity: 0;
                transform:
                    translateY(25px);
            }

            to {
                opacity: 1;
                transform:
                    translateY(0);
            }
        }



        /* =========================
           WORKFLOW
        ========================== */

        .workflow-section {

            width: min(1100px, 90%);

            margin: auto;

            padding: 70px 0 110px;
        }


        .section-heading {

            text-align: center;

            margin-bottom: 65px;
        }


        .section-label {

            color: #38bdf8;

            font-size: 12px;
            font-weight: 700;

            letter-spacing: 1.8px;

            text-transform: uppercase;

            margin-bottom: 14px;

            animation:
                labelGlow 3s ease-in-out infinite;
        }


        @keyframes labelGlow {

            0%,
            100% {
                text-shadow:
                    0 0 0 rgba(56, 189, 248, 0);
            }

            50% {
                text-shadow:
                    0 0 14px rgba(56, 189, 248, 0.45);
            }
        }


        .section-heading h2 {

            color: white;

            font-size:
                clamp(30px, 4vw, 46px);

            letter-spacing: -1.5px;

            margin-bottom: 15px;
        }


        .section-heading p {

            max-width: 650px;

            margin: auto;

            color: #8197b5;

            font-size: 15px;

            line-height: 1.7;
        }



        /* =========================
           STEPS
        ========================== */

        .steps {

            position: relative;

            display: flex;
            flex-direction: column;

            gap: 35px;
        }


        .steps::before {

            content: "";

            position: absolute;

            left: 38px;

            top: 45px;
            bottom: 45px;

            width: 1px;

            background:
                linear-gradient(
                    to bottom,
                    rgba(59, 130, 246, 0.5),
                    rgba(6, 182, 212, 0.15)
                );

            animation:
                lineGlow 4s ease-in-out infinite;
        }


        @keyframes lineGlow {

            0%,
            100% {
                opacity: 0.5;
            }

            50% {
                opacity: 1;
            }
        }


        .step {

            display: grid;

            grid-template-columns:
                76px 1fr;

            gap: 28px;

            position: relative;
        }


        .step-number {

            width: 76px;
            height: 76px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 22px;

            background:
                linear-gradient(
                    145deg,
                    rgba(37, 99, 235, 0.25),
                    rgba(6, 182, 212, 0.10)
                );

            border:
                1px solid rgba(96, 165, 250, 0.25);

            color: #60a5fa;

            font-size: 20px;
            font-weight: 800;

            position: relative;
            z-index: 2;

            box-shadow:
                0 0 30px rgba(37, 99, 235, 0.08);

            transition:
                transform 0.4s ease,
                box-shadow 0.4s ease;
        }


        .step-number::before {

            content: "";

            position: absolute;

            inset: -5px;

            border-radius: 26px;

            border:
                1px solid rgba(56, 189, 248, 0.15);

            animation:
                numberPulse 3s ease-in-out infinite;
        }


        @keyframes numberPulse {

            0%,
            100% {
                transform: scale(1);
                opacity: 0;
            }

            50% {
                transform: scale(1.15);
                opacity: 1;
            }
        }


        .step:hover .step-number {

            transform:
                scale(1.08)
                rotate(-3deg);

            box-shadow:
                0 0 35px rgba(37, 99, 235, 0.3);
        }


        .step-card {

            padding: 32px;

            border-radius: 22px;

            background:
                linear-gradient(
                    145deg,
                    rgba(15, 35, 70, 0.72),
                    rgba(5, 18, 40, 0.88)
                );

            border:
                1px solid rgba(96, 165, 250, 0.12);

            transition:
                transform 0.35s ease,
                border-color 0.35s ease,
                background 0.35s ease,
                box-shadow 0.35s ease;

            position: relative;

            overflow: hidden;

            opacity: 0;

            transform:
                translateY(35px);

            animation:
                cardReveal 0.8s ease forwards;
        }


        .step:nth-child(1) .step-card {
            animation-delay: 0.1s;
        }

        .step:nth-child(2) .step-card {
            animation-delay: 0.25s;
        }

        .step:nth-child(3) .step-card {
            animation-delay: 0.4s;
        }

        .step:nth-child(4) .step-card {
            animation-delay: 0.55s;
        }

        .step:nth-child(5) .step-card {
            animation-delay: 0.7s;
        }


        @keyframes cardReveal {

            to {
                opacity: 1;

                transform:
                    translateY(0);
            }
        }


        .step-card::before {

            content: "";

            position: absolute;

            width: 160px;
            height: 160px;

            border-radius: 50%;

            background:
                rgba(37, 99, 235, 0.07);

            filter: blur(35px);

            right: -70px;
            top: -70px;

            transition:
                transform 0.5s ease;
        }


        .step-card::after {

            content: "";

            position: absolute;

            top: 0;
            left: -120%;

            width: 70%;
            height: 100%;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    rgba(255, 255, 255, 0.035),
                    transparent
                );

            transform:
                skewX(-20deg);

            transition:
                left 0.7s ease;
        }


        .step-card:hover::after {
            left: 130%;
        }


        .step-card:hover::before {

            transform:
                scale(1.5);
        }


        .step-card:hover {

            transform:
                translateY(-7px);

            border-color:
                rgba(96, 165, 250, 0.27);

            background:
                linear-gradient(
                    145deg,
                    rgba(18, 40, 75, 0.82),
                    rgba(6, 20, 42, 0.94)
                );

            box-shadow:
                0 20px 55px rgba(0, 0, 0, 0.25),
                0 0 30px rgba(37, 99, 235, 0.06);
        }


        .step-icon {

            width: 52px;
            height: 52px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 15px;

            background:
                rgba(59, 130, 246, 0.10);

            border:
                1px solid rgba(96, 165, 250, 0.15);

            margin-bottom: 20px;

            transition:
                transform 0.4s ease,
                box-shadow 0.4s ease;
        }


        .step:hover .step-icon {

            transform:
                translateY(-3px)
                rotate(4deg);

            box-shadow:
                0 0 25px rgba(59, 130, 246, 0.16);
        }


        .step-icon i {

            width: 24px;
            height: 24px;

            color: #60a5fa;
        }


        .step-card h3 {

            color: white;

            font-size: 21px;

            margin-bottom: 10px;
        }


        .step-card p {

            max-width: 720px;

            color: #8197b5;

            font-size: 14px;

            line-height: 1.8;
        }



        /* =========================
           FLOW VISUAL
        ========================== */

        .flow-section {

            border-top:
                1px solid rgba(96, 165, 250, 0.08);

            border-bottom:
                1px solid rgba(96, 165, 250, 0.08);

            background:
                rgba(5, 15, 35, 0.35);

            position: relative;

            overflow: hidden;
        }


        .flow-section::before {

            content: "";

            position: absolute;

            width: 400px;
            height: 400px;

            border-radius: 50%;

            background:
                rgba(6, 182, 212, 0.06);

            filter: blur(90px);

            left: -150px;
            top: 30%;

            animation:
                flowOrb 10s ease-in-out infinite;
        }


        @keyframes flowOrb {

            0%,
            100% {
                transform:
                    translate(0, 0);
            }

            50% {
                transform:
                    translate(150px, -60px);
            }
        }


        .flow-container {

            width: min(1100px, 90%);

            margin: auto;

            padding: 90px 0;
        }


        .flow {

            display: grid;

            grid-template-columns:
                1fr
                auto
                1fr
                auto
                1fr;

            align-items: center;

            gap: 18px;
        }


        .flow-box {

            min-height: 190px;

            display: flex;

            flex-direction: column;

            align-items: center;
            justify-content: center;

            text-align: center;

            padding: 25px;

            border-radius: 22px;

            background:
                linear-gradient(
                    145deg,
                    rgba(15, 35, 70, 0.70),
                    rgba(5, 18, 40, 0.88)
                );

            border:
                1px solid rgba(96, 165, 250, 0.13);

            transition:
                transform 0.4s ease,
                border-color 0.4s ease,
                box-shadow 0.4s ease;
        }


        .flow-box:hover {

            transform:
                translateY(-8px)
                scale(1.015);

            border-color:
                rgba(96, 165, 250, 0.30);

            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.25),
                0 0 30px rgba(37, 99, 235, 0.08);
        }


        .flow-icon {

            width: 58px;
            height: 58px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 17px;

            margin-bottom: 15px;

            background:
                linear-gradient(
                    135deg,
                    rgba(37, 99, 235, 0.20),
                    rgba(6, 182, 212, 0.12)
                );

            border:
                1px solid rgba(96, 165, 250, 0.18);

            transition:
                transform 0.4s ease,
                box-shadow 0.4s ease;
        }


        .flow-box:hover .flow-icon {

            transform:
                scale(1.08)
                rotate(5deg);

            box-shadow:
                0 0 28px rgba(56, 189, 248, 0.18);
        }


        .flow-icon i {

            width: 27px;
            height: 27px;

            color: #60a5fa;
        }


        .flow-box h3 {

            color: white;

            font-size: 17px;

            margin-bottom: 7px;
        }


        .flow-box p {

            color: #7187a5;

            font-size: 12px;

            line-height: 1.6;
        }


        .flow-arrow {

            color: #38bdf8;

            animation:
                arrowPulse 2s ease-in-out infinite;
        }


        .flow-arrow:nth-child(2) {
            animation-delay: 0.3s;
        }


        .flow-arrow:nth-child(4) {
            animation-delay: 0.6s;
        }


        @keyframes arrowPulse {

            0%,
            100% {
                opacity: 0.45;
                transform: translateX(0);
            }

            50% {
                opacity: 1;
                transform: translateX(7px);
            }
        }


        .flow-arrow i {

            width: 25px;
            height: 25px;

            filter:
                drop-shadow(
                    0 0 8px rgba(56, 189, 248, 0.5)
                );
        }



        /* =========================
           TECHNOLOGY
        ========================== */

        .tech-section {

            width: min(1100px, 90%);

            margin: auto;

            padding: 100px 0;
        }


        .tech-grid {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 20px;

            margin-top: 50px;
        }


        .tech-card {

            padding: 28px;

            border-radius: 20px;

            background:
                linear-gradient(
                    145deg,
                    rgba(15, 32, 62, 0.65),
                    rgba(5, 17, 37, 0.78)
                );

            border:
                1px solid rgba(96, 165, 250, 0.11);

            transition:
                transform 0.35s ease,
                border-color 0.35s ease,
                box-shadow 0.35s ease;

            position: relative;

            overflow: hidden;
        }


        .tech-card::after {

            content: "";

            position: absolute;

            top: -100%;
            left: -40%;

            width: 180%;
            height: 80px;

            background:
                linear-gradient(
                    transparent,
                    rgba(96, 165, 250, 0.06),
                    transparent
                );

            transform:
                rotate(-10deg);

            transition:
                top 0.7s ease;
        }


        .tech-card:hover::after {
            top: 130%;
        }


        .tech-card:hover {

            transform:
                translateY(-7px);

            border-color:
                rgba(96, 165, 250, 0.25);

            box-shadow:
                0 18px 45px rgba(0, 0, 0, 0.20);
        }


        .tech-card i {

            width: 25px;
            height: 25px;

            color: #38bdf8;

            margin-bottom: 18px;

            transition:
                transform 0.4s ease;
        }


        .tech-card:hover i {

            transform:
                scale(1.15)
                rotate(-5deg);
        }


        .tech-card h3 {

            color: white;

            font-size: 17px;

            margin-bottom: 9px;
        }


        .tech-card p {

            color: #8197b5;

            font-size: 13px;

            line-height: 1.7;
        }



        /* =========================
           CTA
        ========================== */

        .cta-section {

            padding: 30px 20px 100px;
        }


        .cta {

            width: min(1000px, 90%);

            margin: auto;

            padding: 65px 40px;

            text-align: center;

            border-radius: 28px;

            background:
                radial-gradient(
                    circle at 50% 0%,
                    rgba(37, 99, 235, 0.18),
                    transparent 55%
                ),
                rgba(8, 22, 45, 0.8);

            border:
                1px solid rgba(96, 165, 250, 0.15);

            box-shadow:
                0 25px 80px rgba(0, 0, 0, 0.25);

            position: relative;

            overflow: hidden;

            animation:
                ctaFloat 6s ease-in-out infinite;
        }


        .cta::before {

            content: "";

            position: absolute;

            width: 300px;
            height: 300px;

            border-radius: 50%;

            background:
                rgba(37, 99, 235, 0.08);

            filter: blur(70px);

            left: 50%;
            top: -200px;

            transform:
                translateX(-50%);

            animation:
                ctaGlow 5s ease-in-out infinite;
        }


        @keyframes ctaFloat {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-5px);
            }
        }


        @keyframes ctaGlow {

            0%,
            100% {
                opacity: 0.5;
                transform:
                    translateX(-50%)
                    scale(0.9);
            }

            50% {
                opacity: 1;
                transform:
                    translateX(-50%)
                    scale(1.2);
            }
        }


        .cta h2 {

            color: white;

            font-size:
                clamp(30px, 4vw, 44px);

            letter-spacing: -1.5px;

            margin-bottom: 16px;

            position: relative;
        }


        .cta p {

            max-width: 600px;

            margin:
                0 auto 30px;

            color: #8197b5;

            line-height: 1.7;

            font-size: 15px;

            position: relative;
        }


        .cta-button {

            display: inline-flex;

            align-items: center;

            gap: 10px;

            padding: 13px 22px;

            border-radius: 12px;

            color: white;

            text-decoration: none;

            font-size: 14px;

            font-weight: 600;

            background:
                linear-gradient(
                    135deg,
                    #2563eb,
                    #0891b2
                );

            box-shadow:
                0 10px 30px rgba(37, 99, 235, 0.25);

            transition:
                transform 0.3s ease,
                box-shadow 0.3s ease;

            position: relative;

            overflow: hidden;
        }


        .cta-button::before {

            content: "";

            position: absolute;

            top: 0;
            left: -100%;

            width: 70%;
            height: 100%;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    rgba(255,255,255,0.22),
                    transparent
                );

            transform:
                skewX(-20deg);

            transition:
                left 0.6s ease;
        }


        .cta-button:hover::before {
            left: 130%;
        }


        .cta-button:hover {

            transform:
                translateY(-4px)
                scale(1.02);

            box-shadow:
                0 15px 40px rgba(37, 99, 235, 0.42);
        }


        .cta-button i {

            width: 17px;
            height: 17px;

            transition:
                transform 0.3s ease;
        }


        .cta-button:hover i {

            transform:
                translateX(4px);
        }



        /* =========================
           FOOTER
        ========================== */

        footer {

            border-top:
                1px solid rgba(96, 165, 250, 0.09);

            padding: 28px 7%;

            display: flex;

            align-items: center;
            justify-content: space-between;

            color: #607795;

            font-size: 12px;

            animation:
                fadeUp 1s ease both;
        }


        .footer-brand {

            color: #8ca3c0;

            font-weight: 600;

            transition:
                color 0.3s ease;
        }


        .footer-brand:hover {
            color: #60a5fa;
        }



        /* =========================
           RESPONSIVE
        ========================== */

        @media (max-width: 950px) {

            .nav-links {
                gap: 17px;
            }

            .nav-links a {
                font-size: 13px;
            }

            .tech-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }

            .flow {
                grid-template-columns:
                    1fr;
            }

            .flow-arrow {

                transform:
                    rotate(90deg);

                animation:
                    arrowVertical 2s ease-in-out infinite;
            }

            @keyframes arrowVertical {

                0%,
                100% {
                    opacity: 0.45;
                    transform:
                        rotate(90deg)
                        translateX(0);
                }

                50% {
                    opacity: 1;
                    transform:
                        rotate(90deg)
                        translateX(7px);
                }
            }
        }


        @media (max-width: 720px) {

            .navbar {

                height: 70px;

                padding:
                    0 20px;
            }


            .menu-btn {
                display: block;
            }


            .nav-links {

                display: none;

                position: absolute;

                top: 70px;

                left: 0;
                right: 0;

                flex-direction: column;

                gap: 0;

                padding:
                    10px 20px 20px;

                background:
                    rgba(2, 8, 23, 0.97);

                border-bottom:
                    1px solid rgba(96, 165, 250, 0.12);
            }


            .nav-links.show {
                display: flex;

                animation:
                    mobileMenu 0.3s ease both;
            }


            @keyframes mobileMenu {

                from {
                    opacity: 0;
                    transform:
                        translateY(-10px);
                }

                to {
                    opacity: 1;
                    transform:
                        translateY(0);
                }
            }


            .nav-links a {

                width: 100%;

                padding:
                    16px 5px;

                border-bottom:
                    1px solid rgba(96, 165, 250, 0.07);
            }


            .nav-links a.active::after {

                left: 5px;

                bottom: 10px;

                transform: none;

                width: 22px;
            }


            .profile {
                display: none;
            }


            .hero {

                min-height: 65vh;

                padding:
                    80px 20px
                    60px;
            }


            .hero h1 {
                letter-spacing: -2px;
            }


            .hero p {
                font-size: 15px;
            }


            .workflow-section,
            .tech-section,
            .flow-container {

                width: 88%;
            }


            .step {

                grid-template-columns:
                    55px 1fr;

                gap: 17px;
            }


            .step-number {

                width: 55px;
                height: 55px;

                border-radius: 17px;

                font-size: 16px;
            }


            .steps::before {
                left: 27px;
            }


            .step-card {
                padding: 25px;
            }


            .tech-grid {
                grid-template-columns: 1fr;
            }


            .cta {
                padding:
                    45px 25px;
            }


            footer {

                flex-direction: column;

                gap: 10px;

                text-align: center;
            }
        }


        /* =========================
           REDUCED MOTION
        ========================== */

        @media (prefers-reduced-motion: reduce) {

            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {

                animation-duration:
                    0.01ms !important;

                animation-iteration-count:
                    1 !important;

                transition-duration:
                    0.01ms !important;
            }
        }

    </style>

</head>


<body>


    <!-- =========================
         NAVBAR
    ========================== -->

    <%- include("partials/navbar", {
        currentPage: "how-it-works"
    }) %>


    <!-- =========================
         MAIN
    ========================== -->

    <main>


        <!-- HERO -->

        <section class="hero">

            <div class="hero-badge">

                <i data-lucide="workflow"></i>

                How VoiceBridge Works

            </div>


            <h1>

                From Your

                <span>Voice</span>

                to Understanding

            </h1>


            <p>

                VoiceBridge makes Malayalam to English communication
                simple. Speak naturally, let the system process your
                voice, translate the meaning, and receive an English
                result.

            </p>

        </section>



        <!-- =========================
             STEPS
        ========================== -->

        <section class="workflow-section">


            <div class="section-heading">

                <div class="section-label">
                    Simple Process
                </div>


                <h2>
                    How It Works
                </h2>


                <p>

                    The entire translation process is designed around
                    your voice, so you can communicate without typing.

                </p>

            </div>



            <div class="steps">


                <!-- STEP 01 -->

                <div class="step">

                    <div class="step-number">
                        01
                    </div>


                    <div class="step-card">

                        <div class="step-icon">

                            <i data-lucide="mic"></i>

                        </div>


                        <h3>
                            Speak in Malayalam
                        </h3>


                        <p>

                            Start by speaking naturally in Malayalam.
                            VoiceBridge captures your voice through your
                            microphone, so you don't need to type your
                            message manually.

                        </p>

                    </div>

                </div>



                <!-- STEP 02 -->

                <div class="step">

                    <div class="step-number">
                        02
                    </div>


                    <div class="step-card">

                        <div class="step-icon">

                            <i data-lucide="audio-lines"></i>

                        </div>


                        <h3>
                            Speech Is Processed
                        </h3>


                        <p>

                            Your recorded Malayalam speech is processed
                            by the speech recognition system and converted
                            into text that can be understood by the
                            translation system.

                        </p>

                    </div>

                </div>



                <!-- STEP 03 -->

                <div class="step">

                    <div class="step-number">
                        03
                    </div>


                    <div class="step-card">

                        <div class="step-icon">

                            <i data-lucide="languages"></i>

                        </div>


                        <h3>
                            Malayalam Is Translated
                        </h3>


                        <p>

                            The recognized Malayalam text is translated
                            into English while keeping the meaning of
                            your original message as clear as possible.

                        </p>

                    </div>

                </div>



                <!-- STEP 04 -->

                <div class="step">

                    <div class="step-number">
                        04
                    </div>


                    <div class="step-card">

                        <div class="step-icon">

                            <i data-lucide="volume-2"></i>

                        </div>


                        <h3>
                            English Voice Is Generated
                        </h3>


                        <p>

                            The translated English result can then be
                            converted into speech, allowing you to hear
                            the translated message naturally.

                        </p>

                    </div>

                </div>



                <!-- STEP 05 -->

                <div class="step">

                    <div class="step-number">
                        05
                    </div>


                    <div class="step-card">

                        <div class="step-icon">

                            <i data-lucide="message-circle"></i>

                        </div>


                        <h3>
                            Communicate Easily
                        </h3>


                        <p>

                            You can read, listen to, or use the English
                            translation for communication whenever you
                            need it.

                        </p>

                    </div>

                </div>

            </div>

        </section>



        <!-- =========================
             VISUAL FLOW
        ========================== -->

        <section class="flow-section">

            <div class="flow-container">


                <div class="section-heading">

                    <div class="section-label">
                        Translation Flow
                    </div>


                    <h2>
                        One Voice. Three Simple Stages.
                    </h2>


                    <p>

                        VoiceBridge connects speech recognition,
                        translation, and voice generation into one
                        streamlined workflow.

                    </p>

                </div>



                <div class="flow">


                    <!-- INPUT -->

                    <div class="flow-box">

                        <div class="flow-icon">

                            <i data-lucide="mic"></i>

                        </div>


                        <h3>
                            Malayalam Voice
                        </h3>


                        <p>
                            Speak your message naturally.
                        </p>

                    </div>



                    <!-- ARROW -->

                    <div class="flow-arrow">

                        <i data-lucide="arrow-right"></i>

                    </div>



                    <!-- TRANSLATION -->

                    <div class="flow-box">

                        <div class="flow-icon">

                            <i data-lucide="languages"></i>

                        </div>


                        <h3>
                            Translation
                        </h3>


                        <p>
                            Speech becomes text and is translated.
                        </p>

                    </div>



                    <!-- ARROW -->

                    <div class="flow-arrow">

                        <i data-lucide="arrow-right"></i>

                    </div>



                    <!-- OUTPUT -->

                    <div class="flow-box">

                        <div class="flow-icon">

                            <i data-lucide="volume-2"></i>

                        </div>


                        <h3>
                            English Voice
                        </h3>


                        <p>
                            Receive the translated English result.
                        </p>

                    </div>

                </div>

            </div>

        </section>



        <!-- =========================
             TECHNOLOGY
        ========================== -->

        <section class="tech-section">


            <div class="section-heading">

                <div class="section-label">
                    Behind VoiceBridge
                </div>


                <h2>
                    Technology Working Together
                </h2>


                <p>

                    Several technologies work together to turn your
                    Malayalam voice into useful English communication.

                </p>

            </div>



            <div class="tech-grid">


                <div class="tech-card">

                    <i data-lucide="mic"></i>

                    <h3>
                        Speech Recognition
                    </h3>

                    <p>

                        Captures your Malayalam speech and converts
                        spoken words into digital text.

                    </p>

                </div>



                <div class="tech-card">

                    <i data-lucide="brain"></i>

                    <h3>
                        Language Processing
                    </h3>

                    <p>

                        Processes the recognized text so it can be
                        prepared for translation.

                    </p>

                </div>



                <div class="tech-card">

                    <i data-lucide="languages"></i>

                    <h3>
                        Translation Engine
                    </h3>

                    <p>

                        Converts Malayalam text into English while
                        preserving the intended meaning.

                    </p>

                </div>



                <div class="tech-card">

                    <i data-lucide="volume-2"></i>

                    <h3>
                        Text To Speech
                    </h3>

                    <p>

                        Converts the translated English text into
                        spoken audio.

                    </p>

                </div>



                <div class="tech-card">

                    <i data-lucide="database"></i>

                    <h3>
                        Translation History
                    </h3>

                    <p>

                        Previous translation results can be stored
                        and accessed through the history section.

                    </p>

                </div>



                <div class="tech-card">

                    <i data-lucide="share-2"></i>

                    <h3>
                        Easy Sharing
                    </h3>

                    <p>

                        Translation results can be viewed and shared
                        when you need to communicate them.

                    </p>

                </div>

            </div>

        </section>



        <!-- =========================
             CTA
        ========================== -->

        <section class="cta-section">

            <div class="cta">

                <h2>
                    Ready to use your voice?
                </h2>


                <p>

                    Speak in Malayalam and experience a simpler way
                    to communicate in English.

                </p>


                <a href="/translate" class="cta-button">

                    Start Translating

                    <i data-lucide="arrow-right"></i>

                </a>

            </div>

        </section>

    </main>



    <!-- =========================
         FOOTER
    ========================== -->

    <footer>

        <div class="footer-brand">
            VoiceBridge
        </div>


        <div>

            © <%= new Date().getFullYear() %> VoiceBridge.
            All rights reserved.

        </div>

    </footer>



    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>

        lucide.createIcons();


        const menuBtn =
            document.getElementById("menuBtn");

        const navLinks =
            document.getElementById("navLinks");


        if (menuBtn && navLinks) {

            menuBtn.addEventListener("click", () => {

                navLinks.classList.toggle("show");


                const icon =
                    menuBtn.querySelector("i");


                if (
                    navLinks.classList.contains("show")
                ) {

                    icon.setAttribute(
                        "data-lucide",
                        "x"
                    );

                } else {

                    icon.setAttribute(
                        "data-lucide",
                        "menu"
                    );
                }


                lucide.createIcons();

            });



            document
                .querySelectorAll(".nav-links a")
                .forEach(link => {

                    link.addEventListener(
                        "click",
                        () => {

                            navLinks.classList.remove(
                                "show"
                            );


                            const icon =
                                menuBtn.querySelector("i");


                            if (icon) {

                                icon.setAttribute(
                                    "data-lucide",
                                    "menu"
                                );

                                lucide.createIcons();

                            }

                        }
                    );

                });

        }



        /* =========================
           PREMIUM MOUSE EFFECT
        ========================== */

        document
            .querySelectorAll(
                ".step-card, .tech-card, .flow-box"
            )
            .forEach(card => {

                card.addEventListener(
                    "mousemove",
                    (e) => {

                        const rect =
                            card.getBoundingClientRect();

                        const x =
                            e.clientX - rect.left;

                        const y =
                            e.clientY - rect.top;

                        const centerX =
                            rect.width / 2;

                        const centerY =
                            rect.height / 2;

                        const rotateX =
                            ((y - centerY) / centerY) * -2;

                        const rotateY =
                            ((x - centerX) / centerX) * 2;


                        card.style.transform =
                            `perspective(900px)
                             rotateX(${rotateX}deg)
                             rotateY(${rotateY}deg)
                             translateY(-5px)`;

                    }
                );


                card.addEventListener(
                    "mouseleave",
                    () => {

                        card.style.transform =
                            "";

                    }
                );

            });



        /* =========================
           SCROLL REVEAL
        ========================== */

        const revealElements =
            document.querySelectorAll(
                ".section-heading, .tech-card, .flow-box, .cta"
            );


        const revealObserver =
            new IntersectionObserver(
                entries => {

                    entries.forEach(entry => {

                        if (
                            entry.isIntersecting
                        ) {

                            entry.target.classList.add(
                                "revealed"
                            );

                            revealObserver.unobserve(
                                entry.target
                            );

                        }

                    });

                },
                {
                    threshold: 0.15
                }
            );


        revealElements.forEach(
            element => {

                element.classList.add(
                    "scroll-reveal"
                );

                revealObserver.observe(
                    element
                );

            }
        );



        /* =========================
           DYNAMIC REVEAL STYLE
        ========================== */

        const dynamicRevealStyle =
            document.createElement("style");


        dynamicRevealStyle.innerHTML = `

            .scroll-reveal {

                opacity: 0;

                transform:
                    translateY(35px)
                    scale(0.98);

                transition:
                    opacity 0.8s ease,
                    transform 0.8s cubic-bezier(
                        0.22,
                        1,
                        0.36,
                        1
                    );

            }


            .scroll-reveal.revealed {

                opacity: 1;

                transform:
                    translateY(0)
                    scale(1);

            }

        `;


        document.head.appendChild(
            dynamicRevealStyle
        );

    </script>


</body>

</html>