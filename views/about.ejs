<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>About | VoiceBridge</title>

  <meta
    name="description"
    content="Learn more about VoiceBridge — a voice translation platform connecting Malayalam and English through speech technology."
  />

  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* =========================================================
       RESET
    ========================================================== */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, Arial, sans-serif;

      background: #020817;
      color: #e5f0ff;

      min-height: 100vh;
      overflow-x: hidden;
    }

    img {
      max-width: 100%;
      display: block;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    ::selection {
      background: rgba(59, 130, 246, 0.35);
      color: #ffffff;
    }


    /* =========================================================
       PAGE LOADER
    ========================================================== */

    .page-loader {
      position: fixed;
      inset: 0;
      z-index: 99999;

      display: flex;
      align-items: center;
      justify-content: center;

      background: #020817;

      transition:
        opacity 0.7s ease,
        visibility 0.7s ease;
    }

    .page-loader.hide {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .loader-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
    }

    .loader-logo {
      width: 58px;
      height: 58px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 17px;

      background:
        linear-gradient(
          135deg,
          #2563eb,
          #0891b2
        );

      box-shadow:
        0 0 30px rgba(37, 99, 235, 0.35);

      animation: loaderPulse 1.5s ease-in-out infinite;
    }

    .loader-logo i {
      width: 27px;
      height: 27px;
      color: #ffffff;
    }

    .loader-line {
      width: 110px;
      height: 2px;

      border-radius: 20px;
      overflow: hidden;

      background: rgba(96, 165, 250, 0.12);
    }

    .loader-line::after {
      content: "";

      display: block;

      width: 45%;
      height: 100%;

      border-radius: inherit;

      background:
        linear-gradient(
          90deg,
          #60a5fa,
          #22d3ee
        );

      animation: loaderLine 1.1s ease-in-out infinite;
    }

    @keyframes loaderPulse {
      0%,
      100% {
        transform: scale(1);
        box-shadow:
          0 0 25px rgba(37, 99, 235, 0.25);
      }

      50% {
        transform: scale(1.08);
        box-shadow:
          0 0 45px rgba(37, 99, 235, 0.5);
      }
    }

    @keyframes loaderLine {
      0% {
        transform: translateX(-110%);
      }

      100% {
        transform: translateX(250%);
      }
    }


    /* =========================================================
       BACKGROUND
    ========================================================== */

    body::before {
      content: "";

      position: fixed;
      inset: 0;

      pointer-events: none;

      z-index: -10;

      background:
        radial-gradient(
          circle at 15% 20%,
          rgba(37, 99, 235, 0.18),
          transparent 32%
        ),
        radial-gradient(
          circle at 85% 15%,
          rgba(6, 182, 212, 0.13),
          transparent 30%
        ),
        radial-gradient(
          circle at 50% 90%,
          rgba(99, 102, 241, 0.12),
          transparent 35%
        );
    }

    body::after {
      content: "";

      position: fixed;
      inset: 0;

      pointer-events: none;

      z-index: -9;

      background-image:
        linear-gradient(
          rgba(59, 130, 246, 0.035) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(59, 130, 246, 0.035) 1px,
          transparent 1px
        );

      background-size: 45px 45px;
    }


    /* =========================================================
       STAR FIELD
    ========================================================== */

    .stars,
    .stars::before,
    .stars::after {
      position: fixed;
      inset: 0;

      pointer-events: none;

      z-index: -8;

      content: "";
    }

    .stars {
      background-image:
        radial-gradient(circle, rgba(255,255,255,0.65) 1px, transparent 1.5px),
        radial-gradient(circle, rgba(96,165,250,0.5) 1px, transparent 1.5px),
        radial-gradient(circle, rgba(34,211,238,0.45) 1px, transparent 1.5px);

      background-size:
        160px 160px,
        220px 220px,
        310px 310px;

      background-position:
        20px 30px,
        80px 120px,
        150px 70px;

      opacity: 0.28;

      animation: starDrift 45s linear infinite;
    }

    .stars::before {
      background-image:
        radial-gradient(circle, rgba(255,255,255,0.55) 1px, transparent 1.5px),
        radial-gradient(circle, rgba(125,211,252,0.4) 1px, transparent 1.5px);

      background-size:
        260px 260px,
        190px 190px;

      opacity: 0.25;

      animation: starDriftReverse 70s linear infinite;
    }

    .stars::after {
      background:
        radial-gradient(
          circle at 30% 40%,
          rgba(37, 99, 235, 0.06),
          transparent 25%
        ),
        radial-gradient(
          circle at 70% 65%,
          rgba(6, 182, 212, 0.05),
          transparent 25%
        );

      animation: ambientPulse 7s ease-in-out infinite;
    }

    @keyframes starDrift {
      from {
        transform: translate3d(0, 0, 0);
      }

      to {
        transform: translate3d(-100px, 100px, 0);
      }
    }

    @keyframes starDriftReverse {
      from {
        transform: translate3d(0, 0, 0);
      }

      to {
        transform: translate3d(120px, -80px, 0);
      }
    }

    @keyframes ambientPulse {
      0%,
      100% {
        opacity: 0.45;
      }

      50% {
        opacity: 1;
      }
    }


    /* =========================================================
       MOUSE GLOW
    ========================================================== */

    .cursor-glow {
      position: fixed;

      width: 320px;
      height: 320px;

      border-radius: 50%;

      pointer-events: none;

      z-index: -5;

      background:
        radial-gradient(
          circle,
          rgba(37, 99, 235, 0.10),
          rgba(6, 182, 212, 0.035) 35%,
          transparent 70%
        );

      transform: translate(-50%, -50%);

      transition:
        left 0.12s ease-out,
        top 0.12s ease-out;

      opacity: 0.8;
    }


    /* =========================================================
       FLOATING BACKGROUND ORBS
    ========================================================== */

    .ambient-orb {
      position: absolute;

      border-radius: 50%;

      pointer-events: none;

      filter: blur(1px);

      opacity: 0.7;
    }

    .orb-one {
      width: 170px;
      height: 170px;

      top: 18%;
      left: -80px;

      background:
        radial-gradient(
          circle,
          rgba(37, 99, 235, 0.16),
          transparent 70%
        );

      animation:
        orbFloatOne 10s ease-in-out infinite;
    }

    .orb-two {
      width: 210px;
      height: 210px;

      top: 42%;
      right: -110px;

      background:
        radial-gradient(
          circle,
          rgba(6, 182, 212, 0.13),
          transparent 70%
        );

      animation:
        orbFloatTwo 13s ease-in-out infinite;
    }

    .orb-three {
      width: 180px;
      height: 180px;

      bottom: 8%;
      left: 40%;

      background:
        radial-gradient(
          circle,
          rgba(99, 102, 241, 0.10),
          transparent 70%
        );

      animation:
        orbFloatThree 12s ease-in-out infinite;
    }

    @keyframes orbFloatOne {
      0%,
      100% {
        transform: translate(0, 0);
      }

      50% {
        transform: translate(40px, 60px);
      }
    }

    @keyframes orbFloatTwo {
      0%,
      100% {
        transform: translate(0, 0);
      }

      50% {
        transform: translate(-50px, -40px);
      }
    }

    @keyframes orbFloatThree {
      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-55px);
      }
    }


    /* =========================================================
       NAVBAR
    ========================================================== */

    .navbar {
      width: 100%;
      height: 78px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 0 7%;

      position: sticky;
      top: 0;

      z-index: 1000;

      background: rgba(2, 8, 23, 0.78);

      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);

      border-bottom:
        1px solid rgba(96, 165, 250, 0.12);

      transition:
        background 0.3s ease,
        box-shadow 0.3s ease;
    }

    .navbar.scrolled {
      background: rgba(2, 8, 23, 0.92);

      box-shadow:
        0 10px 40px rgba(0, 0, 0, 0.22);
    }


    /* Logo */

    .brand {
      display: flex;
      align-items: center;

      gap: 11px;

      color: #ffffff;

      text-decoration: none;

      font-size: 20px;
      font-weight: 700;

      letter-spacing: -0.4px;

      transition: 0.3s ease;
    }

    .brand:hover {
      color: #60a5fa;
    }

    .brand-icon {
      width: 38px;
      height: 38px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 11px;

      background:
        linear-gradient(
          135deg,
          rgba(37, 99, 235, 0.95),
          rgba(6, 182, 212, 0.9)
        );

      box-shadow:
        0 0 25px rgba(37, 99, 235, 0.25);

      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
    }

    .brand:hover .brand-icon {
      transform: rotate(-5deg) scale(1.06);

      box-shadow:
        0 0 35px rgba(37, 99, 235, 0.45);
    }

    .brand-icon i {
      width: 20px;
      height: 20px;

      color: white;
    }


    /* Nav links */

    .nav-links {
      display: flex;
      align-items: center;

      gap: 28px;
    }

    .nav-links a {
      position: relative;

      color: #8fa4c2;

      text-decoration: none;

      font-size: 14px;
      font-weight: 500;

      padding: 28px 0;

      transition:
        color 0.3s ease;
    }

    .nav-links a:hover {
      color: #ffffff;
    }

    .nav-links a.active {
      color: #ffffff;
    }

    .nav-links a.active::after {
      content: "";

      position: absolute;

      left: 50%;
      bottom: 17px;

      width: 26px;
      height: 2px;

      transform: translateX(-50%);

      background: #3d9cff;

      border-radius: 10px;

      box-shadow:
        0 0 10px rgba(61, 156, 255, 0.8);

      animation: activeGlow 2s ease-in-out infinite;
    }

    @keyframes activeGlow {
      0%,
      100% {
        opacity: 0.65;
        box-shadow:
          0 0 7px rgba(61, 156, 255, 0.5);
      }

      50% {
        opacity: 1;
        box-shadow:
          0 0 16px rgba(61, 156, 255, 0.95);
      }
    }


    /* Profile */

    .profile {
      width: 38px;
      height: 38px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;

      background:
        rgba(59, 130, 246, 0.12);

      border:
        1px solid rgba(96, 165, 250, 0.22);

      color: #93c5fd;

      font-size: 12px;
      font-weight: 700;
    }


    /* Mobile menu */

    .menu-btn {
      display: none;

      border: none;
      background: transparent;

      color: white;

      cursor: pointer;
    }

    .menu-btn i {
      width: 24px;
      height: 24px;
    }


    /* =========================================================
       MAIN
    ========================================================== */

    main {
      width: 100%;
      position: relative;
    }


    /* =========================================================
       HERO
    ========================================================== */

    .hero {
      min-height: 78vh;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      text-align: center;

      padding: 110px 20px 100px;

      position: relative;

      overflow: hidden;
    }

    .hero::before {
      content: "";

      position: absolute;

      width: 520px;
      height: 520px;

      border-radius: 50%;

      background:
        radial-gradient(
          circle,
          rgba(37, 99, 235, 0.17),
          transparent 68%
        );

      filter: blur(70px);

      top: 30px;
      left: 50%;

      transform: translateX(-50%);

      z-index: -2;

      animation:
        heroGlow 7s ease-in-out infinite;
    }

    .hero::after {
      content: "";

      position: absolute;

      width: 70%;
      height: 1px;

      bottom: 0;
      left: 15%;

      background:
        linear-gradient(
          90deg,
          transparent,
          rgba(96, 165, 250, 0.22),
          transparent
        );

      box-shadow:
        0 0 30px rgba(37, 99, 235, 0.15);
    }

    @keyframes heroGlow {
      0%,
      100% {
        transform:
          translateX(-50%)
          scale(0.95);
        opacity: 0.7;
      }

      50% {
        transform:
          translateX(-50%)
          scale(1.1);
        opacity: 1;
      }
    }


    /* Hero badge */

    .hero-badge {
      display: inline-flex;
      align-items: center;

      gap: 8px;

      padding: 8px 14px;

      margin-bottom: 25px;

      border-radius: 30px;

      background:
        rgba(59, 130, 246, 0.08);

      border:
        1px solid rgba(96, 165, 250, 0.18);

      color: #7dd3fc;

      font-size: 12px;
      font-weight: 600;

      letter-spacing: 0.4px;

      box-shadow:
        0 0 25px rgba(37, 99, 235, 0.05);

      animation:
        heroFadeDown 0.8s ease both,
        badgeFloat 4s ease-in-out 1s infinite;
    }

    .hero-badge i {
      width: 14px;
      height: 14px;

      animation:
        sparkleRotate 3s linear infinite;
    }

    @keyframes sparkleRotate {
      0% {
        transform: rotate(0deg) scale(1);
      }

      50% {
        transform: rotate(180deg) scale(1.1);
      }

      100% {
        transform: rotate(360deg) scale(1);
      }
    }

    @keyframes badgeFloat {
      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-4px);
      }
    }


    /* Hero heading */

    .hero h1 {
      max-width: 950px;

      font-size:
        clamp(42px, 7vw, 78px);

      line-height: 1.02;

      letter-spacing: -3px;

      color: #ffffff;

      margin-bottom: 25px;

      animation:
        heroFadeUp 0.9s 0.1s ease both;
    }

    .hero h1 span {
      background:
        linear-gradient(
          90deg,
          #60a5fa,
          #22d3ee,
          #818cf8,
          #60a5fa
        );

      background-size: 250% auto;

      -webkit-background-clip: text;
      background-clip: text;

      color: transparent;

      animation:
        gradientText 5s linear infinite;
    }

    @keyframes gradientText {
      0% {
        background-position: 0% center;
      }

      100% {
        background-position: 250% center;
      }
    }


    /* Typing */

    .typing-wrap {
      min-height: 30px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin-bottom: 18px;
    }

    .typing-text {
      color: #60a5fa;

      font-size: 14px;
      font-weight: 600;

      letter-spacing: 0.8px;
    }

    .typing-cursor {
      display: inline-block;

      width: 2px;
      height: 17px;

      margin-left: 5px;

      background: #22d3ee;

      animation:
        cursorBlink 0.8s steps(1) infinite;
    }

    @keyframes cursorBlink {
      50% {
        opacity: 0;
      }
    }


    .hero p {
      max-width: 700px;

      color: #8fa4c2;

      font-size: 17px;

      line-height: 1.8;

      animation:
        heroFadeUp 0.9s 0.25s ease both;
    }


    /* Hero floating visual */

    .hero-visual {
      width: min(700px, 95%);

      margin-top: 55px;

      position: relative;

      animation:
        heroVisualIn 1.1s 0.35s ease both;
    }

    .hero-image-frame {
      position: relative;

      overflow: hidden;

      border-radius: 28px;

      border:
        1px solid rgba(96, 165, 250, 0.16);

      background:
        rgba(5, 18, 40, 0.7);

      box-shadow:
        0 35px 100px rgba(0, 0, 0, 0.35),
        0 0 50px rgba(37, 99, 235, 0.08);

      transform:
        perspective(1000px)
        rotateX(2deg);

      transition:
        transform 0.5s ease,
        border-color 0.5s ease;
    }

    .hero-image-frame:hover {
      transform:
        perspective(1000px)
        rotateX(0deg)
        translateY(-5px);

      border-color:
        rgba(96, 165, 250, 0.3);
    }

    .hero-image {
      width: 100%;
      height: 270px;

      object-fit: cover;

      opacity: 0.72;

      filter:
        saturate(0.85)
        brightness(0.68)
        contrast(1.05);

      transition:
        transform 0.8s ease,
        opacity 0.8s ease;
    }

    .hero-image-frame:hover .hero-image {
      transform: scale(1.045);
      opacity: 0.82;
    }

    .hero-image-overlay {
      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          180deg,
          rgba(2, 8, 23, 0.1),
          rgba(2, 8, 23, 0.88)
        );
    }

    .hero-image-content {
      position: absolute;

      inset: auto 30px 25px 30px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;

      text-align: left;
    }

    .language-pill {
      display: flex;
      align-items: center;
      gap: 10px;

      padding: 10px 14px;

      border-radius: 12px;

      background:
        rgba(2, 8, 23, 0.65);

      border:
        1px solid rgba(96, 165, 250, 0.18);

      backdrop-filter: blur(12px);

      color: #dbeafe;

      font-size: 12px;
      font-weight: 600;
    }

    .language-pill i {
      width: 16px;
      height: 16px;

      color: #60a5fa;
    }

    .language-arrow {
      width: 36px;
      height: 36px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;

      background:
        linear-gradient(
          135deg,
          rgba(37, 99, 235, 0.85),
          rgba(6, 182, 212, 0.75)
        );

      box-shadow:
        0 0 25px rgba(37, 99, 235, 0.25);
    }

    .language-arrow i {
      width: 17px;
      height: 17px;
      color: white;
    }


    /* =========================================================
       SHARED SECTION
    ========================================================== */

    .section {
      width: min(1150px, 90%);

      margin: auto;

      padding: 95px 0;

      position: relative;
    }

    .section-label {
      color: #38bdf8;

      font-size: 12px;

      font-weight: 700;

      letter-spacing: 1.8px;

      text-transform: uppercase;

      margin-bottom: 14px;
    }


    /* =========================================================
       SCROLL REVEAL
    ========================================================== */

    .reveal {
      opacity: 0;

      transform:
        translateY(45px)
        scale(0.985);

      transition:
        opacity 0.85s ease,
        transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal-left {
      opacity: 0;

      transform:
        translateX(-55px);

      transition:
        opacity 0.9s ease,
        transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal-right {
      opacity: 0;

      transform:
        translateX(55px);

      transition:
        opacity 0.9s ease,
        transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal.visible,
    .reveal-left.visible,
    .reveal-right.visible {
      opacity: 1;

      transform:
        translate(0)
        scale(1);
    }


    /* =========================================================
       ABOUT
    ========================================================== */

    .about-grid {
      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 65px;

      align-items: center;
    }

    .about-content h2 {
      font-size:
        clamp(32px, 4vw, 48px);

      line-height: 1.1;

      letter-spacing: -1.5px;

      color: #ffffff;

      margin-bottom: 22px;
    }

    .about-content h2 span {
      color: #60a5fa;

      position: relative;
    }

    .about-content h2 span::after {
      content: "";

      position: absolute;

      left: 0;
      right: 0;
      bottom: -5px;

      height: 2px;

      border-radius: 10px;

      background:
        linear-gradient(
          90deg,
          #60a5fa,
          #22d3ee,
          transparent
        );

      transform-origin: left;

      animation:
        lineGrow 2s 1s ease both;
    }

    @keyframes lineGrow {
      from {
        transform: scaleX(0);
      }

      to {
        transform: scaleX(1);
      }
    }

    .about-content p {
      color: #8fa4c2;

      font-size: 15px;

      line-height: 1.85;

      margin-bottom: 18px;
    }


    /* =========================================================
       ABOUT VISUAL
    ========================================================== */

    .about-visual {
      min-height: 430px;

      display: flex;
      align-items: center;
      justify-content: center;

      position: relative;
    }

    .visual-glow {
      position: absolute;

      width: 320px;
      height: 320px;

      border-radius: 50%;

      background:
        radial-gradient(
          circle,
          rgba(37, 99, 235, 0.28),
          transparent 70%
        );

      filter: blur(15px);

      animation:
        visualGlowPulse 5s ease-in-out infinite;
    }

    @keyframes visualGlowPulse {
      0%,
      100% {
        transform: scale(0.9);
        opacity: 0.55;
      }

      50% {
        transform: scale(1.12);
        opacity: 1;
      }
    }

    .voice-card {
      width: min(410px, 100%);

      padding: 35px;

      border-radius: 24px;

      background:
        linear-gradient(
          145deg,
          rgba(15, 35, 70, 0.92),
          rgba(5, 18, 40, 0.97)
        );

      border:
        1px solid rgba(96, 165, 250, 0.18);

      box-shadow:
        0 25px 80px rgba(0, 0, 0, 0.35),
        0 0 40px rgba(37, 99, 235, 0.08);

      position: relative;

      z-index: 1;

      overflow: hidden;

      animation:
        cardFloat 6s ease-in-out infinite;

      transition:
        transform 0.4s ease,
        border-color 0.4s ease;
    }

    .voice-card::before {
      content: "";

      position: absolute;

      top: -100%;
      left: -70%;

      width: 50%;
      height: 300%;

      background:
        linear-gradient(
          90deg,
          transparent,
          rgba(255,255,255,0.045),
          transparent
        );

      transform: rotate(25deg);

      transition:
        left 0.8s ease;
    }

    .voice-card:hover::before {
      left: 140%;
    }

    .voice-card:hover {
      transform:
        translateY(-10px)
        rotateX(2deg);

      border-color:
        rgba(96, 165, 250, 0.32);
    }

    @keyframes cardFloat {
      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-9px);
      }
    }


    /* Voice card image */

    .voice-card-image {
      width: 100%;
      height: 145px;

      object-fit: cover;

      border-radius: 17px;

      margin-bottom: 25px;

      opacity: 0.58;

      filter:
        saturate(0.7)
        brightness(0.65);

      border:
        1px solid rgba(96, 165, 250, 0.12);

      transition:
        transform 0.6s ease,
        opacity 0.6s ease;
    }

    .voice-card:hover .voice-card-image {
      transform: scale(1.025);
      opacity: 0.72;
    }


    .voice-icon {
      width: 65px;
      height: 65px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 18px;

      margin-bottom: 25px;

      background:
        linear-gradient(
          135deg,
          rgba(37, 99, 235, 0.25),
          rgba(6, 182, 212, 0.16)
        );

      border:
        1px solid rgba(96, 165, 250, 0.2);

      box-shadow:
        0 0 30px rgba(37, 99, 235, 0.08);
    }

    .voice-icon i {
      width: 31px;
      height: 31px;

      color: #60a5fa;

      animation:
        micPulse 2.4s ease-in-out infinite;
    }

    @keyframes micPulse {
      0%,
      100% {
        transform: scale(1);
      }

      50% {
        transform: scale(1.1);
      }
    }

    .voice-card h3 {
      color: white;

      font-size: 23px;

      margin-bottom: 12px;
    }

    .voice-card p {
      color: #8197b5;

      font-size: 14px;

      line-height: 1.7;
    }


    /* =========================================================
       WAVE
    ========================================================== */

    .wave {
      display: flex;

      align-items: center;

      gap: 5px;

      height: 55px;

      margin-top: 25px;
    }

    .wave span {
      display: block;

      width: 4px;

      border-radius: 10px;

      background:
        linear-gradient(
          to bottom,
          #38bdf8,
          #2563eb
        );

      animation:
        wave 1.2s ease-in-out infinite;
    }

    .wave span:nth-child(1) {
      height: 20px;
      animation-delay: 0.1s;
    }

    .wave span:nth-child(2) {
      height: 34px;
      animation-delay: 0.2s;
    }

    .wave span:nth-child(3) {
      height: 48px;
      animation-delay: 0.3s;
    }

    .wave span:nth-child(4) {
      height: 28px;
      animation-delay: 0.4s;
    }

    .wave span:nth-child(5) {
      height: 42px;
      animation-delay: 0.5s;
    }

    .wave span:nth-child(6) {
      height: 25px;
      animation-delay: 0.6s;
    }

    .wave span:nth-child(7) {
      height: 38px;
      animation-delay: 0.7s;
    }

    @keyframes wave {
      0%,
      100% {
        transform: scaleY(0.55);
        opacity: 0.5;
      }

      50% {
        transform: scaleY(1);
        opacity: 1;
      }
    }


    /* =========================================================
       FEATURES SECTION
    ========================================================== */

    .features-section {
      position: relative;

      border-top:
        1px solid rgba(96, 165, 250, 0.08);

      border-bottom:
        1px solid rgba(96, 165, 250, 0.08);

      background:
        rgba(5, 15, 35, 0.35);

      overflow: hidden;
    }

    .features-section::before {
      content: "";

      position: absolute;

      width: 500px;
      height: 500px;

      border-radius: 50%;

      top: 10%;
      left: 50%;

      transform: translateX(-50%);

      background:
        radial-gradient(
          circle,
          rgba(37, 99, 235, 0.07),
          transparent 70%
        );

      filter: blur(30px);

      pointer-events: none;

      animation:
        featureAmbient 8s ease-in-out infinite;
    }

    @keyframes featureAmbient {
      0%,
      100% {
        transform:
          translateX(-50%)
          scale(0.9);
      }

      50% {
        transform:
          translateX(-50%)
          scale(1.15);
      }
    }

    .section-heading {
      text-align: center;

      margin-bottom: 55px;

      position: relative;
      z-index: 1;
    }

    .section-heading h2 {
      font-size:
        clamp(30px, 4vw, 45px);

      color: #ffffff;

      letter-spacing: -1.4px;

      margin-bottom: 15px;
    }

    .section-heading p {
      max-width: 650px;

      margin: auto;

      color: #8197b5;

      line-height: 1.7;

      font-size: 15px;
    }


    /* =========================================================
       FEATURE GRID
    ========================================================== */

    .features-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 20px;

      position: relative;
      z-index: 1;
    }

    .feature-card {
      padding: 30px;

      min-height: 245px;

      border-radius: 20px;

      background:
        linear-gradient(
          145deg,
          rgba(15, 32, 62, 0.68),
          rgba(5, 17, 37, 0.75)
        );

      border:
        1px solid rgba(96, 165, 250, 0.12);

      transition:
        transform 0.4s ease,
        border-color 0.4s ease,
        background 0.4s ease,
        box-shadow 0.4s ease;

      position: relative;

      overflow: hidden;

      opacity: 0;
      transform: translateY(35px);
    }

    .feature-card.visible {
      opacity: 1;
      transform: translateY(0);

      transition:
        opacity 0.7s ease,
        transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
        border-color 0.4s ease,
        background 0.4s ease,
        box-shadow 0.4s ease;
    }

    .feature-card::before {
      content: "";

      position: absolute;

      width: 150px;
      height: 150px;

      border-radius: 50%;

      background:
        rgba(37, 99, 235, 0.08);

      filter: blur(25px);

      top: -60px;
      right: -60px;

      transition:
        transform 0.5s ease,
        opacity 0.5s ease;
    }

    .feature-card::after {
      content: "";

      position: absolute;

      left: -100%;

      top: 0;

      width: 70%;
      height: 1px;

      background:
        linear-gradient(
          90deg,
          transparent,
          rgba(125, 211, 252, 0.5),
          transparent
        );

      transition:
        left 0.8s ease;
    }

    .feature-card:hover::after {
      left: 130%;
    }

    .feature-card:hover::before {
      transform: scale(1.5);
      opacity: 1;
    }

    .feature-card:hover {
      transform:
        translateY(-8px);

      border-color:
        rgba(96, 165, 250, 0.28);

      background:
        linear-gradient(
          145deg,
          rgba(18, 40, 75, 0.85),
          rgba(6, 20, 42, 0.9)
        );

      box-shadow:
        0 22px 55px rgba(0, 0, 0, 0.22),
        0 0 30px rgba(37, 99, 235, 0.07);
    }

    .feature-card:nth-child(1) {
      transition-delay: 0.05s;
    }

    .feature-card:nth-child(2) {
      transition-delay: 0.12s;
    }

    .feature-card:nth-child(3) {
      transition-delay: 0.19s;
    }

    .feature-card:nth-child(4) {
      transition-delay: 0.26s;
    }

    .feature-card:nth-child(5) {
      transition-delay: 0.33s;
    }

    .feature-card:nth-child(6) {
      transition-delay: 0.40s;
    }


    /* Feature image */

    .feature-image {
      width: 100%;
      height: 115px;

      object-fit: cover;

      border-radius: 14px;

      margin-bottom: 20px;

      opacity: 0.42;

      filter:
        saturate(0.65)
        brightness(0.55);

      border:
        1px solid rgba(96, 165, 250, 0.10);

      transition:
        transform 0.6s ease,
        opacity 0.6s ease;
    }

    .feature-card:hover .feature-image {
      transform: scale(1.035);

      opacity: 0.6;
    }


    .feature-icon {
      width: 52px;
      height: 52px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 15px;

      background:
        rgba(59, 130, 246, 0.11);

      border:
        1px solid rgba(96, 165, 250, 0.15);

      margin-bottom: 22px;

      transition:
        transform 0.35s ease,
        box-shadow 0.35s ease;
    }

    .feature-card:hover .feature-icon {
      transform:
        translateY(-3px)
        rotate(-3deg);

      box-shadow:
        0 0 25px rgba(37, 99, 235, 0.12);
    }

    .feature-icon i {
      width: 24px;
      height: 24px;

      color: #60a5fa;
    }

    .feature-card h3 {
      color: #ffffff;

      font-size: 18px;

      margin-bottom: 10px;
    }

    .feature-card p {
      color: #8197b5;

      font-size: 14px;

      line-height: 1.7;
    }


    /* =========================================================
       MISSION
    ========================================================== */

    .mission {
      text-align: center;

      max-width: 900px;

      margin: auto;

      position: relative;
    }

    .mission h2 {
      color: white;

      font-size:
        clamp(30px, 4vw, 46px);

      letter-spacing: -1.5px;

      margin-bottom: 22px;
    }

    .mission p {
      color: #8fa4c2;

      font-size: 16px;

      line-height: 1.9;
    }


    /* Mission image */

    .mission-image-wrap {
      width: min(760px, 100%);

      margin: 45px auto 0;

      position: relative;

      border-radius: 25px;

      overflow: hidden;

      border:
        1px solid rgba(96, 165, 250, 0.14);

      box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.3);
    }

    .mission-image {
      width: 100%;
      height: 280px;

      object-fit: cover;

      opacity: 0.55;

      filter:
        saturate(0.65)
        brightness(0.55);

      transition:
        transform 0.8s ease,
        opacity 0.8s ease;
    }

    .mission-image-wrap:hover .mission-image {
      transform: scale(1.045);
      opacity: 0.68;
    }

    .mission-image-overlay {
      position: absolute;
      inset: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      background:
        linear-gradient(
          180deg,
          rgba(2, 8, 23, 0.15),
          rgba(2, 8, 23, 0.72)
        );
    }

    .mission-quote {
      padding: 14px 22px;

      border-radius: 30px;

      background:
        rgba(2, 8, 23, 0.62);

      border:
        1px solid rgba(96, 165, 250, 0.2);

      backdrop-filter: blur(12px);

      color: #dbeafe;

      font-size: 14px;
      font-weight: 600;

      letter-spacing: 0.2px;

      box-shadow:
        0 10px 35px rgba(0, 0, 0, 0.2);

      animation:
        quoteFloat 4s ease-in-out infinite;
    }

    @keyframes quoteFloat {
      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-6px);
      }
    }


    /* =========================================================
       STATS
    ========================================================== */

    .stats {
      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 15px;

      margin-top: 55px;
    }

    .stat {
      text-align: center;

      padding: 25px 15px;

      border-radius: 16px;

      background:
        rgba(10, 25, 50, 0.5);

      border:
        1px solid rgba(96, 165, 250, 0.1);

      transition:
        transform 0.35s ease,
        border-color 0.35s ease,
        background 0.35s ease;
    }

    .stat:hover {
      transform: translateY(-6px);

      border-color:
        rgba(96, 165, 250, 0.24);

      background:
        rgba(12, 31, 60, 0.68);
    }

    .stat h3 {
      font-size: 30px;

      color: #60a5fa;

      margin-bottom: 7px;

      text-shadow:
        0 0 18px rgba(96, 165, 250, 0.18);
    }

    .stat p {
      color: #7187a5;

      font-size: 12px;
    }


    /* =========================================================
       CTA
    ========================================================== */

    .cta-section {
      padding: 80px 20px 110px;

      position: relative;
    }

    .cta {
      width: min(1000px, 90%);

      margin: auto;

      padding: 70px 40px;

      text-align: center;

      border-radius: 28px;

      position: relative;

      overflow: hidden;

      background:
        radial-gradient(
          circle at 50% 0%,
          rgba(37, 99, 235, 0.18),
          transparent 55%
        ),
        rgba(8, 22, 45, 0.8);

      border:
        1px solid rgba(96, 165, 250, 0.15);

      box-shadow:
        0 25px 80px rgba(0, 0, 0, 0.25),
        0 0 50px rgba(37, 99, 235, 0.05);

      transition:
        transform 0.5s ease,
        border-color 0.5s ease;
    }

    .cta::before {
      content: "";

      position: absolute;

      width: 250px;
      height: 250px;

      border-radius: 50%;

      top: -180px;
      left: 50%;

      transform: translateX(-50%);

      background:
        rgba(37, 99, 235, 0.12);

      filter: blur(20px);

      animation:
        ctaGlow 5s ease-in-out infinite;
    }

    .cta:hover {
      transform: translateY(-5px);

      border-color:
        rgba(96, 165, 250, 0.28);
    }

    @keyframes ctaGlow {
      0%,
      100% {
        transform:
          translateX(-50%)
          scale(0.9);
      }

      50% {
        transform:
          translateX(-50%)
          scale(1.2);
      }
    }

    .cta h2 {
      color: white;

      font-size:
        clamp(30px, 4vw, 44px);

      letter-spacing: -1.5px;

      margin-bottom: 16px;

      position: relative;
      z-index: 1;
    }

    .cta p {
      max-width: 600px;

      margin: 0 auto 30px;

      color: #8197b5;

      line-height: 1.7;

      font-size: 15px;

      position: relative;
      z-index: 1;
    }

    .cta-button {
      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 10px;

      padding: 13px 22px;

      border-radius: 12px;

      color: white;

      text-decoration: none;

      font-size: 14px;

      font-weight: 600;

      background:
        linear-gradient(
          135deg,
          #2563eb,
          #0891b2
        );

      box-shadow:
        0 10px 30px rgba(37, 99, 235, 0.25);

      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;

      position: relative;

      z-index: 1;

      overflow: hidden;
    }

    .cta-button::before {
      content: "";

      position: absolute;

      top: 0;
      left: -120%;

      width: 80%;
      height: 100%;

      background:
        linear-gradient(
          90deg,
          transparent,
          rgba(255,255,255,0.18),
          transparent
        );

      transform: skewX(-20deg);

      transition:
        left 0.7s ease;
    }

    .cta-button:hover::before {
      left: 140%;
    }

    .cta-button:hover {
      transform: translateY(-3px);

      box-shadow:
        0 15px 35px rgba(37, 99, 235, 0.4);
    }

    .cta-button i {
      width: 17px;
      height: 17px;

      transition:
        transform 0.3s ease;
    }

    .cta-button:hover i {
      transform: translateX(4px);
    }


    /* =========================================================
       FOOTER
    ========================================================== */

    footer {
      border-top:
        1px solid rgba(96, 165, 250, 0.09);

      padding: 28px 7%;

      display: flex;

      align-items: center;

      justify-content: space-between;

      color: #607795;

      font-size: 12px;
    }

    .footer-brand {
      color: #8ca3c0;

      font-weight: 600;
    }


    /* =========================================================
       SCROLL PROGRESS
    ========================================================== */

    .scroll-progress {
      position: fixed;

      top: 0;
      left: 0;

      width: 0%;
      height: 2px;

      z-index: 9999;

      background:
        linear-gradient(
          90deg,
          #2563eb,
          #22d3ee,
          #818cf8
        );

      box-shadow:
        0 0 10px rgba(34, 211, 238, 0.5);
    }


    /* =========================================================
       BACK TO TOP
    ========================================================== */

    .back-top {
      position: fixed;

      right: 25px;
      bottom: 25px;

      width: 42px;
      height: 42px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 13px;

      border:
        1px solid rgba(96, 165, 250, 0.2);

      background:
        rgba(5, 18, 40, 0.78);

      backdrop-filter: blur(12px);

      color: #93c5fd;

      cursor: pointer;

      opacity: 0;
      visibility: hidden;

      transform:
        translateY(15px);

      transition:
        opacity 0.3s ease,
        visibility 0.3s ease,
        transform 0.3s ease,
        background 0.3s ease;

      z-index: 900;
    }

    .back-top.show {
      opacity: 1;
      visibility: visible;

      transform:
        translateY(0);
    }

    .back-top:hover {
      background:
        rgba(37, 99, 235, 0.18);

      transform:
        translateY(-4px);
    }

    .back-top i {
      width: 18px;
      height: 18px;
    }


    /* =========================================================
       RESPONSIVE
    ========================================================== */

    @media (max-width: 950px) {

      .nav-links {
        gap: 17px;
      }

      .nav-links a {
        font-size: 13px;
      }

      .about-grid {
        grid-template-columns: 1fr;

        gap: 35px;
      }

      .about-content {
        text-align: center;
      }

      .about-content h2 span::after {
        left: 10%;
        right: 10%;
      }

      .features-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }

      .stats {
        grid-template-columns:
          repeat(2, 1fr);
      }
    }


    @media (max-width: 720px) {

      .navbar {
        height: 70px;

        padding:
          0 20px;
      }

      .menu-btn {
        display: block;
      }

      .nav-links {
        display: none;

        position: absolute;

        top: 70px;
        left: 0;
        right: 0;

        flex-direction: column;

        gap: 0;

        padding:
          10px 20px 20px;

        background:
          rgba(2, 8, 23, 0.97);

        border-bottom:
          1px solid rgba(96, 165, 250, 0.12);
      }

      .nav-links.show {
        display: flex;
      }

      .nav-links a {
        width: 100%;

        padding:
          16px 5px;

        border-bottom:
          1px solid rgba(96, 165, 250, 0.07);
      }

      .nav-links a.active::after {
        left: 5px;
        bottom: 10px;

        transform: none;

        width: 22px;
      }

      .profile {
        display: none;
      }

      .hero {
        min-height: 70vh;

        padding:
          80px 20px 65px;
      }

      .hero h1 {
        letter-spacing: -2px;
      }

      .hero p {
        font-size: 15px;
      }

      .hero-visual {
        margin-top: 40px;
      }

      .hero-image {
        height: 210px;
      }

      .hero-image-content {
        inset:
          auto 16px 16px 16px;
      }

      .language-pill {
        padding:
          8px 10px;

        font-size: 10px;
      }

      .language-arrow {
        width: 30px;
        height: 30px;
      }

      .section {
        width: 88%;

        padding:
          65px 0;
      }

      .features-grid {
        grid-template-columns: 1fr;
      }

      .feature-card {
        min-height: auto;
      }

      .voice-card {
        padding: 28px;
      }

      .voice-card-image {
        height: 125px;
      }

      .mission-image {
        height: 210px;
      }

      .stats {
        grid-template-columns:
          repeat(2, 1fr);

        gap: 10px;
      }

      .stat {
        padding:
          20px 10px;
      }

      .cta {
        width: 92%;

        padding:
          45px 25px;
      }

      footer {
        flex-direction: column;

        gap: 10px;

        text-align: center;
      }

      .back-top {
        right: 17px;
        bottom: 17px;
      }

      .cursor-glow {
        display: none;
      }
    }


    @media (max-width: 420px) {

      .hero h1 {
        font-size: 39px;
      }

      .hero-badge {
        font-size: 10px;
      }

      .typing-text {
        font-size: 12px;
      }

      .hero-image {
        height: 185px;
      }

      .hero-image-content {
        flex-wrap: wrap;
        justify-content: center;
      }

      .language-arrow {
        display: none;
      }

      .stats {
        grid-template-columns: 1fr 1fr;
      }

      .stat h3 {
        font-size: 25px;
      }
    }


    /* =========================================================
       REDUCED MOTION
    ========================================================== */

    @media (prefers-reduced-motion: reduce) {

      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }

      .reveal,
      .reveal-left,
      .reveal-right,
      .feature-card {
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>
</head>


<body>

  <!-- =========================================================
       LOADER
  ========================================================== -->

  <div class="page-loader" id="pageLoader">
    <div class="loader-content">
      <div class="loader-logo">
        <i data-lucide="languages"></i>
      </div>

      <div class="loader-line"></div>
    </div>
  </div>


  <!-- =========================================================
       BACKGROUND EFFECTS
  ========================================================== -->

  <div class="stars"></div>

  <div class="cursor-glow" id="cursorGlow"></div>


  <!-- =========================================================
       NAVBAR
  ========================================================== -->

  <%- include("partials/navbar", { currentPage: "about" }) %>


  <!-- =========================================================
       SCROLL PROGRESS
  ========================================================== -->

